{
  "name": "instagram-morph-counter",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion recreation of an Instagram feed clip with a morphing colorful counter digit",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Instagram out/instagram.mp4",
    "still": "remotion still src/index.ts Instagram out/frame.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
